# Keep the populated owner-only env file outside the checkout; it has paths, not tokens.
BOX3_OTA_IMAGE_TAG=REPLACE_WITH_SOURCE_CONTENT_TAG
BOX3_OTA_SOCKET_GID=REPLACE_WITH_NUMERIC_GROUP
# Set the unused loopback port directly in the private config.json.
BOX3_OTA_CONFIG=/ABSOLUTE/PRIVATE/config.json
BOX3_OTA_TOKEN=/ABSOLUTE/PRIVATE/admin.token
BOX3_OTA_STATE_DIR=/ABSOLUTE/PERSISTENT/state
BOX3_OTA_RUNTIME_DIR=/run/box3-ota
